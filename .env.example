# Apple 公证凭据模板 —— 使用时复制为 .env 并填入真实值（.env 已加入 .gitignore，切勿提交）
# electron-builder 会自动读取项目根目录的 .env

# 登录 developer.apple.com 的 Apple ID 邮箱
APPLE_ID=

# App 专用密码（不是 Apple ID 登录密码）
# 生成入口：https://appleid.apple.com/account/manage → 登录与安全 → App 专用密码 → 生成密码
APPLE_APP_SPECIFIC_PASSWORD=

# 开发者 Team ID（签名证书名称括号内的 10 位码，当前本机为 JAQ4VAD5UH；若付费账号归属不同 team 需修改）
APPLE_TEAM_ID=JAQ4VAD5UH
